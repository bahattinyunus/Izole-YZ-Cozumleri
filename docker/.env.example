# ==============================================================================
# İzole YZ Çözümleri: Ortam Değişkenleri Şablonu (.env)
# ==============================================================================

# Ağ ve Servis Ayarları
GATEWAY_PORT=8080
WEBUI_PORT=3000
QDRANT_PORT=6333

# LLM Motoru (vLLM veya Ollama)
UPSTREAM_LLM_URL=http://llm-engine:11434/v1/chat/completions
MODEL_NAME=llama3.1:8b

# Güvenlik ve Gizlilik
AIRGAP_STRICT_MODE=true
DLP_REDACTION_ENABLED=true
MASK_TCKN=true
MASK_CREDIT_CARD=true
MASK_IBAN=true
MASK_API_KEYS=true

# Telemetri ve Dış Takip Kapatma
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
